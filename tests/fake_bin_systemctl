#!/bin/sh
# Fake systemctl for sandbox tests: remembers whether the timer is on.
S="${VB_TEST_STATE:-/tmp/vb-fake-timer}"
while [ "$1" = "--user" ] || [ "$1" = "-M" ] || [ "${1#*@}" != "$1" ]; do shift; done
case "$1" in
  is-active) case "$2" in *.timer) [ -f "$S" ] && { echo active; exit 0; } ;; esac; echo inactive; exit 3 ;;
  show) [ -f "$S" ] && echo "Fri 2026-10-23 17:02:00 CEST" || echo "n/a" ;;
  enable) touch "$S"; echo "enabled" ;;
  disable) rm -f "$S"; echo "disabled" ;;
  start) echo "started $*" >> "$S.log" ;;
esac
exit 0
